{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamiejcross/hyperscale-landscapes/data/sites/schema.json",
  "title": "Hyperscale Landscapes curated site",
  "description": "One proposed (or related) data-centre site. Record only corporate and planning information, each with a source. Never personal data.",
  "type": "object",
  "required": [
    "type",
    "geometry",
    "properties"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "geometry": {
      "description": "Footprint of the proposed facility, or null until a sourced footprint exists (then no insert is made).",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon"
              ]
            }
          }
        }
      ]
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "developer",
        "local_authority",
        "status",
        "planning_refs",
        "stated_capacity_mw",
        "stated_height_m",
        "stated_floor_area_m2",
        "footprint_precision",
        "sources",
        "last_verified",
        "licence",
        "notes",
        "model_bbox"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "site_role": {
          "enum": [
            "data centre",
            "related infrastructure"
          ]
        },
        "developer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Company name only."
        },
        "local_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_authority_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            null,
            "rumoured",
            "pre-application",
            "application lodged",
            "consented",
            "refused",
            "withdrawn",
            "operational"
          ]
        },
        "planning_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "stated_capacity_mw": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "grid_connection_mw": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stated_height_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stated_floor_area_m2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stated_site_area_ha": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stated_building_area_ha": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "footprint_precision": {
          "enum": [
            null,
            "exact from plans",
            "digitised from images",
            "approximate"
          ]
        },
        "massing_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[lon, lat] of the site marker"
        },
        "location_precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "reported_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "accessed": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            }
          }
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "licence": {
          "const": "CC-BY-4.0"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_bbox": {
          "type": "object",
          "required": [
            "min_lat",
            "max_lat",
            "min_lon",
            "max_lon"
          ],
          "properties": {
            "min_lat": {
              "type": "number"
            },
            "max_lat": {
              "type": "number"
            },
            "min_lon": {
              "type": "number"
            },
            "max_lon": {
              "type": "number"
            }
          }
        },
        "model_bbox_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_bbox_wide": {
          "type": "object"
        },
        "model_bbox_wide_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "turbines": {
          "description": "Optional, filled by hand from planning documents: wind turbine dimensions for this site's turbines where OpenStreetMap does not give them. Used only for the 3D view; labelled 'curated' with its source.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "hub_height": {
              "type": "number",
              "minimum": 10,
              "maximum": 250
            },
            "rotor_diameter": {
              "type": "number",
              "minimum": 10,
              "maximum": 300
            },
            "source": {
              "type": "string",
              "minLength": 3
            }
          },
          "required": [
            "source"
          ]
        }
      }
    }
  }
}
